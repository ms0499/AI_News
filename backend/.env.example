# Copy to backend/.env for local development. Do not commit your real .env.

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL — separate database from any other project on the same server)
# ---------------------------------------------------------------------------
# Format: postgresql+pg8000://USER:PASSWORD@HOST:PORT/DB_NAME
# (pg8000 is a pure-Python driver — no pg_config/compiler needed on the NAS, unlike psycopg2)
AI_NEWS_DB_URI=postgresql+pg8000://appuser:replace-with-password@localhost:5432/ai_news

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_SECRET_KEY=replace-with-a-long-random-string
# Local dev default is 8010. On the NAS, set this to 6001 — that's the port the
# "AI-News" Cloudflare tunnel (ainews.damsm.com) is already configured to forward to.
PORT=8010

# Gunicorn tuning (production only — run_gunicorn.sh / gunicorn.conf.py). Optional,
# shown here with their defaults.
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4

# ---------------------------------------------------------------------------
# AI summarization/tagging (optional — ingestion still works without it,
# articles just keep their raw source summary instead of an AI one)
# ---------------------------------------------------------------------------
AI_SUMMARIZE_ENABLED=true
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Max Gemini summarize calls per ingestion run (protects the free-tier quota;
# articles past the cap keep their raw summary). Default 100.
AI_SUMMARIZE_MAX_PER_RUN=100

# ---------------------------------------------------------------------------
# Optional news aggregator API (NewsAPI.org). Leave unset to skip this source.
# ---------------------------------------------------------------------------
NEWSAPI_KEY=

# Reddit and Hacker News use public, unauthenticated JSON endpoints — no keys needed.

# CORS: origin of the frontend dev server / prod site. In production the built
# frontend is served by this same Flask app (same origin as the API), so CORS_ORIGIN
# only matters for local Vite dev — leave it pointed at the prod hostname on the NAS
# as a harmless default, e.g. CORS_ORIGIN=https://ainews.damsm.com
CORS_ORIGIN=http://localhost:5173
